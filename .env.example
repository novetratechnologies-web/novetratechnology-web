APP_NAME="IGM Church"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Installation & Single Church Configuration
CHURCH_INSTALLED=false
PRIMARY_CHURCH_ID=

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=churchcms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo transactional email uses its SMTP relay. Add your verified sender in Brevo.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

REMINDER=mail

MAIL_FROM_ADDRESS=noreply@example.com

MAIL_STATUS=on

# HostPinnacle SMS credentials (API key is sent in the `apikey` request header).
HOSTPINNACLE_SMS_ENDPOINT=https://smsportal.hostpinnacle.co.ke/SMSApi/send
HOSTPINNACLE_API_KEY=
HOSTPINNACLE_SENDER_ID=
SMS_STATUS=off

FCM_PROJECT_ID=
FCM_TIMEOUT=30

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TIMEZONE=Africa/Nairobi

FILESYSTEM_DRIVER=local

AWS_KEY=
AWS_SECRET=
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=


GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

MIX_AWS_ACCESS_KEY=
MIX_AWS_SECRET_KEY=
MIX_AWS_ARN_URL=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_KEY=
TWILIO_SECRET=

DEBUG_BAR=true

KURENTO_VIDEO=http://localhost/video/
KURENTO_SERVER=http://localhost:3000/

ANALYTICS_VIEW_ID=
CACHE_TIME=84000
APP_TIMEZONE=UTC
# Path to a Firebase service-account JSON file used by the FCM HTTP v1 sender.
FIREBASE_CREDENTIALS=
CACHE_TIME=84000
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CURRENCY=NGN
#stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=

# GCash (via PayMongo)
GCASH_PUBLIC_KEY=
GCASH_SECRET_KEY=
GCASH_CURRENCY=PHP

# Optional local-only account for database\seeders\DevelopmentAdminSeeder.
# Set these values in .env before running it; use a unique password of 16+ characters.
DEV_ADMIN_NAME=Development Church Admin
DEV_ADMIN_EMAIL=
DEV_ADMIN_MOBILE=
DEV_ADMIN_MOBILE_COUNTRY_CODE=+254
DEV_ADMIN_CHURCH_ID=
DEV_ADMIN_PASSWORD=

# MediaMTX live video server. Start it with: docker compose -f docker-compose.streaming.yml up -d
# Local URLs; replace localhost with your public media-server host when deploying.
STREAM_INGEST_URL=rtmp://127.0.0.1:1935
STREAM_PLAYBACK_URL=http://127.0.0.1:8888/{path}/index.m3u8
STREAM_PATH_PREFIX=live
STREAM_AUTH_USERNAME_PREFIX=igm-church-
# Set a long random secret and use the same value in the MediaMTX container environment.
STREAM_WEBHOOK_TOKEN=replace-with-a-long-random-secret
STREAM_AUTH_URL=http://host.docker.internal:8000/api/streaming/auth
STREAM_WEBHOOK_URL=http://host.docker.internal:8000/api/streaming/status
